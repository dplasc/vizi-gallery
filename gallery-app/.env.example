# Supabase (Vizi project); service role for server-side gallery_albums access
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth (public; use same values as main Vizi project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the main Vizi app (for SSO verify and redirect links)
VIZI_BASE_URL=https://www.vizi.hr

# Shared secret sent as X-Gallery-SSO-Secret when verifying SSO tokens with Vizi
GALLERY_SSO_VERIFY_SECRET=your-shared-sso-verify-secret
